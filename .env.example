# ValidMind API credentials for the quickstart.
#
# Get them from the ValidMind Platform: Model Inventory → select your model →
# Getting Started → "Copy snippet to clipboard".
#
# These land in a Kubernetes Secret shaped like an OpenShift AI *connection*,
# so the workbench (and the scheduled pipeline) pick them up as environment
# variables. Never commit .env.

# ValidMind API host — keep the default unless you run a private instance.
VM_API_HOST=https://app.prod.validmind.ai/api/v1/tracking

# Required: API key + secret from your ValidMind organization.
VM_API_KEY=changeme
VM_API_SECRET=changeme

# Required: the inventory model identifier (cuid) test results attach to.
VM_API_MODEL=changeme
